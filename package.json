{
  "name": "polyrepo-cli",
  "version": "1.3.1",
  "description": "Interactive CLI for managing a folder of local npm package repos: version bumps through a PR, npm publish, GitHub releases, and cross-package dependency drift checks — all from one tool.",
  "homepage": "https://npm.vuecraft.ru/en/packages/polyrepo-cli/",
  "type": "module",
  "bin": {
    "polyrepo": "./src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:ui": "vite build --config ui/vite.config.ts",
    "prepublishOnly": "npm test && npm run typecheck:ui && npm run build:ui",
    "dev:ui": "node ui/dev.mjs",
    "typecheck:ui": "vue-tsc --noEmit -p ui/tsconfig.json",
    "format:ui": "prettier --write ui"
  },
  "files": [
    "src",
    "ui-dist",
    "polyrepo.config.example.json"
  ],
  "keywords": [
    "cli",
    "polyrepo",
    "monorepo",
    "multi-repo",
    "npm",
    "release",
    "version-bump",
    "github-release",
    "changelog"
  ],
  "author": {
    "name": "Danil Lisin Vladimirovich (Macrulez)",
    "email": "macrulezru@gmail.com",
    "url": "https://macrulez.ru/en"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/polyrepo-cli.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
